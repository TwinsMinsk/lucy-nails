# Next.js загружает переменные только из папки frontend (например .env.local).
# Скопируйте в .env.local и подставьте значения или продублируйте блок NEXT_PUBLIC_* из корневого .env.

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production/staging examples (Railway frontend service, build-time):
# NEXT_PUBLIC_API_URL=https://api.lucysmirnova.ru/api
# NEXT_PUBLIC_SITE_URL=https://lucysmirnova.ru
