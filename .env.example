# Монорепозиторий: этот файл обычно копируют в `.env` в КОРНЕ репозитория.
# Backend (FastAPI) читает корневой `.env` и при необходимости `backend/.env` (он переопределяет корень).
# Frontend (Next.js) по умолчанию НЕ читает корневой `.env` — для локального UI используйте
# `frontend/.env.local` (см. frontend/.env.example).

# === Database ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nails_course
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nails_course

# === Redis (опционально для MVP) ===
REDIS_URL=redis://localhost:6379/0

# === Auth ===
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Kinescope ===
KINESCOPE_API_KEY=your-kinescope-api-key
KINESCOPE_PROJECT_ID=your-project-id

# === Prodamus (см. backend/app/services/prodamus_service.py) ===
# URL платёжной формы из ЛК Prodamus, например https://yourshop.payform.ru/
PRODAMUS_URL=https://yourshop.payform.ru/
PRODAMUS_SECRET_KEY=your-prodamus-secret-key
PRODAMUS_SHOP_ID=your-shop-id

# === SMTP (опционально; основной MVP checkout требует регистрацию до оплаты) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_NAME=Lucy Nails Academy
SMTP_REQUIRED_FOR_PAYMENT_EMAIL=false

# Публичные URL для редиректов и вебхука (обязательны на staging/production)
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# === Telegram ===
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_SUPPORT_GROUP_INVITE=https://t.me/+xxxxx

# === Frontend (Next.js: продублировать в frontend/.env.local) ===
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Environment ===
ENVIRONMENT=development
DEBUG=true

# Дополнительно (опционально): CORS — список origin через запятую; пусто = из FRONTEND_URL
# CORS_ORIGINS=https://lucysmirnova.ru,https://www.lucysmirnova.ru

# Дополнительно (опционально, production): разрешённые Host заголовки (через запятую)
# TRUSTED_HOSTS=api.lucysmirnova.ru,lucysmirnova.ru,localhost

# Дней доступа к курсу после успешной оплаты (v1: 30)
# COURSE_ACCESS_DAYS=30

# Production upload: пусто = локальные uploads отключены в production.
# Для настоящего production используйте persistent storage/S3/R2/Cloudinary.
# UPLOAD_STORAGE_DIR=
# UPLOAD_PUBLIC_BASE_URL=https://cdn.example.com/uploads
