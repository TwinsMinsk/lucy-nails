# Монорепозиторий: этот файл обычно копируют в `.env` в КОРНЕ репозитория.
# Backend (FastAPI) читает корневой `.env` и при необходимости `backend/.env` (он переопределяет корень).
# Frontend (Next.js) по умолчанию НЕ читает корневой `.env` — для локального UI используйте
# `frontend/.env.local` (см. frontend/.env.example).

# === Database ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nails_course
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nails_course

# === Redis (опционально для MVP) ===
REDIS_URL=redis://localhost:6379/0

# === Auth ===
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Kinescope ===
KINESCOPE_API_KEY=your-kinescope-api-key
# UUID проекта (не короткий «slug»), берём из Dashboard → Настройки проекта
KINESCOPE_PROJECT_ID=00000000-0000-0000-0000-000000000000

# --- Kinescope DRM Authorization Backend (см. Docs/integrations/KINESCOPE_AUTH_BACKEND.md) ---
# Один из двух вариантов хранения приватного ключа RSA:
#   PATH — путь к PEM-файлу (локально, через volume в Railway)
#   PEM  — инлайн-строка PEM (на Railway удобнее, экранируйте \n как \\n)
KINESCOPE_JWT_PRIVATE_KEY_PATH=
KINESCOPE_JWT_PRIVATE_KEY_PEM=
# Key ID, которым подписан JWK; печатается setup_drm.py
KINESCOPE_JWK_KID=
# Время жизни drmauthtoken в секундах (рекомендуется 300)
KINESCOPE_DRM_TOKEN_TTL_SECONDS=300
# HTTP Basic Auth, ожидаемый webhook'ом /api/integrations/kinescope/drm/authorize
# (тот же логин/пароль настраивается в Kinescope через PUT /v1/drm/auth/{project})
KINESCOPE_DRM_BASIC_USER=
KINESCOPE_DRM_BASIC_PASS=

# === Prodamus (см. backend/app/services/prodamus_service.py) ===
# URL платёжной формы из ЛК Prodamus, например https://yourshop.payform.ru/
PRODAMUS_URL=https://yourshop.payform.ru/
PRODAMUS_SECRET_KEY=your-prodamus-secret-key
PRODAMUS_SHOP_ID=your-shop-id
# Тестовые платежи: 1 — все ссылки идут с demo_mode=1 (работают тестовые карты),
# 0 — реальные платежи. Вне production demo включён всегда. Перед go-live: 0.
PRODAMUS_DEMO_MODE=0

# === SMTP (Gmail: нужен App Password, не обычный пароль аккаунта) ===
# 1) Включить 2FA в Google → https://myaccount.google.com/apppasswords
# 2) Создать пароль приложения (16 символов)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM_NAME=Lucy Nails Academy
# На staging/production, если письмо после оплаты обязательно — true (см. validate_production_safety в config)
SMTP_REQUIRED_FOR_PAYMENT_EMAIL=false

# Публичные URL для редиректов и вебхука (обязательны на staging/production)
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# === Telegram ===
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_SUPPORT_GROUP_INVITE=https://t.me/+xxxxx

# === Frontend (Next.js: продублировать в frontend/.env.local) ===
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Environment ===
ENVIRONMENT=development
DEBUG=true

# Dev-seed пароли (только при ENVIRONMENT=development; на staging/production seed не выполняется).
# Пусто — пароль сгенерируется и залогируется один раз (WARNING). Задайте, чтобы зафиксировать.
SEED_ADMIN_PASSWORD=
SEED_STUDENT_PASSWORD=

# Дополнительно (опционально): CORS — список origin через запятую; пусто = из FRONTEND_URL
# CORS_ORIGINS=https://lucysmirnova.ru,https://www.lucysmirnova.ru

# Дополнительно (опционально, production): разрешённые Host заголовки (через запятую)
# TRUSTED_HOSTS=api.lucysmirnova.ru,lucysmirnova.ru,localhost

# Дней доступа к курсу после успешной оплаты (v1: 30)
# COURSE_ACCESS_DAYS=30

# Production upload: пусто = локальные uploads отключены в production.
# Для настоящего production используйте persistent storage/S3/R2/Cloudinary.
# UPLOAD_STORAGE_DIR=
# UPLOAD_PUBLIC_BASE_URL=https://cdn.example.com/uploads
