# Монорепозиторий: этот файл обычно копируют в `.env` в КОРНЕ репозитория.
# Backend (FastAPI) читает корневой `.env` и при необходимости `backend/.env` (он переопределяет корень).
# Frontend (Next.js) по умолчанию НЕ читает корневой `.env` — для локального UI используйте
# `frontend/.env.local` (см. frontend/.env.example).

# === Database ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nails_course
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nails_course

# === Redis (опционально для MVP) ===
REDIS_URL=redis://localhost:6379/0

# === Auth ===
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Kinescope ===
KINESCOPE_API_KEY=your-kinescope-api-key
KINESCOPE_PROJECT_ID=your-project-id

# === Prodamus ===
PRODAMUS_API_KEY=your-prodamus-api-key
PRODAMUS_SECRET_KEY=your-prodamus-secret-key
PRODAMUS_SHOP_ID=your-shop-id

# === Telegram ===
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_SUPPORT_GROUP_INVITE=https://t.me/+xxxxx

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Environment ===
ENVIRONMENT=development
DEBUG=true
