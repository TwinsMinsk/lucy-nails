{
	admin off
	auto_https off
}

# Fly's proxy terminates TLS and forwards plain HTTP to this port.
:8080 {
	# Russian data centres cannot reach Railway, so provider callbacks come
	# here and are passed through unchanged. The backend still verifies the
	# Prodamus Sign header and the Kinescope Basic auth; this relay trusts
	# nothing and adds nothing.
	@relayed path /api/payments/webhook /api/integrations/kinescope/drm/authorize
	handle @relayed {
		request_body {
			max_size 64KB
		}
		reverse_proxy https://api.lucysmirnova.ru {
			header_up Host api.lucysmirnova.ru
			transport http {
				dial_timeout 5s
				response_header_timeout 20s
			}
		}
	}

	handle /healthz {
		respond "ok" 200
	}

	handle {
		respond 404
	}

	log
}
